<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="#F4F7F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Thư viện sách của tôi" android:textSize="25sp"
        android:textStyle="bold" android:textColor="#24483F" android:paddingBottom="12dp"/>
    <TextView android:id="@+id/txtStatistics" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFF"
        android:background="#356859" android:padding="14dp" android:text="Thống kê"/>
    <Button android:id="@+id/btnAddBook" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="+ Thêm sách"
        android:textColor="#FFFFFF" android:backgroundTint="#356859"
        android:layout_marginTop="14dp" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Danh sách sách" android:textSize="18sp" android:textStyle="bold"
        android:textColor="#24483F" android:paddingTop="8dp" android:paddingBottom="4dp"/>
    <ListView android:id="@+id/listBooks" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="#D6E1DB" android:dividerHeight="1dp"
        android:background="#FFFFFF" android:padding="4dp"/>
</LinearLayout>
