<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F4F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📚" android:textSize="54sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="THƯ VIỆN CỦA TÔI" android:textSize="24sp"
            android:textStyle="bold" android:textColor="#24483F" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Đăng nhập để quản lý sách của bạn" android:textSize="15sp"
            android:textColor="#52645D" android:layout_marginBottom="28dp"/>
        <EditText android:id="@+id/edtUsername" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Tên đăng nhập"
            android:singleLine="true" android:inputType="text" android:padding="14dp"
            android:backgroundTint="#356859"/>
        <EditText android:id="@+id/edtPassword" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Mật khẩu"
            android:singleLine="true" android:inputType="textPassword"
            android:padding="14dp" android:layout_marginTop="12dp" android:backgroundTint="#356859"/>
        <TextView android:id="@+id/txtError" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B3261E"
            android:visibility="gone" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ĐĂNG NHẬP"
            android:textColor="#FFFFFF" android:backgroundTint="#356859"
            android:layout_marginTop="22dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tài khoản thử: admin  |  Mật khẩu: 123456"
            android:textSize="12sp" android:textColor="#687870" android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>
