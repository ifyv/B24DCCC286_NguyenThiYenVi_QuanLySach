<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Thêm sách mới" android:textSize="25sp" android:textStyle="bold"
            android:textColor="#24483F" android:paddingBottom="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tên sách *" android:textStyle="bold" android:textColor="#24483F"/>
        <EditText android:id="@+id/edtTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Nhập tên sách"
            android:inputType="textCapSentences" android:singleLine="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tác giả *" android:textStyle="bold" android:textColor="#24483F"
            android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtAuthor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Nhập tên tác giả"
            android:inputType="textCapWords" android:singleLine="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Thể loại" android:textStyle="bold" android:textColor="#24483F"
            android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spCategory" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tình trạng đọc" android:textStyle="bold" android:textColor="#24483F"
            android:layout_marginTop="8dp"/>
        <RadioGroup android:id="@+id/rgStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/rbUnread" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Chưa đọc" android:checked="true"/>
            <RadioButton android:id="@+id/rbReading" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Đang đọc"/>
            <RadioButton android:id="@+id/rbRead" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Đã đọc"/>
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Đánh giá (0–5 sao)" android:textStyle="bold" android:textColor="#24483F"
            android:layout_marginTop="8dp"/>
        <RatingBar android:id="@+id/ratingBar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:numStars="5" android:stepSize="1.0"
            android:rating="0"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ghi chú" android:textStyle="bold" android:textColor="#24483F"
            android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtNote" android:layout_width="match_parent"
            android:layout_height="100dp" android:gravity="top|start"
            android:hint="Ghi chú thêm (không bắt buộc)"
            android:inputType="textMultiLine|textCapSentences" android:padding="10dp"/>
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Lưu sách"
            android:textColor="#FFFFFF" android:backgroundTint="#356859"
            android:layout_marginTop="16dp"/>
        <Button android:id="@+id/btnCancel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Hủy"
            android:backgroundTint="#DCE7E1" android:textColor="#24483F"/>
    </LinearLayout>
</ScrollView>
